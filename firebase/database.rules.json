{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".write": "auth != null && data.child('meta/hostUid').val() === auth.uid",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists() && $code.matches(/^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{6}$/) && newData.child('hostUid').val() === auth.uid",
          ".validate": "newData.hasChildren(['hostUid', 'phase', 'createdAt', 'expiresAt']) && (!data.exists() || newData.child('hostUid').val() === data.child('hostUid').val())",
          "hostUid": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "phase": {
            ".validate": "newData.val() === 'lobby' || newData.val() === 'playing'"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
          },
          "expiresAt": {
            ".validate": "newData.isNumber() && ((!data.exists() && newData.val() > now && newData.val() <= now + 129600000) || (data.exists() && newData.val() === data.val()))"
          },
          "$other": {
            ".validate": false
          }
        },
        "catalog": {
          ".read": "auth != null && root.child('rooms').child($code).child('meta/expiresAt').val() > now"
        },
        "state": {
          ".read": "auth != null && root.child('rooms').child($code).child('meta/expiresAt').val() > now && (root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid || root.child('rooms').child($code).child('members').child(auth.uid).exists())"
        },
        "members": {
          ".read": "auth != null && root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('meta/phase').val() === 'lobby' && root.child('rooms').child($code).child('meta/expiresAt').val() > now && root.child('rooms').child($code).child('meta/hostUid').val() !== auth.uid && (data.exists() || !root.child('rooms').child($code).child('state/members/7').exists())",
            ".validate": "newData.hasChildren(['name','joinedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
            },
            "token": {
              ".validate": "newData.isString() && newData.val().length <= 24"
            },
            "startingPin": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "joinedAt": {
              ".validate": "newData.isNumber() && ((!data.exists() && newData.val() <= now + 60000 && newData.val() >= now - 60000) || (data.exists() && newData.val() === data.val()))"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "presence": {
          ".read": "auth != null && root.child('rooms').child($code).child('meta/expiresAt').val() > now && (root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid || root.child('rooms').child($code).child('members').child(auth.uid).exists())",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('meta/expiresAt').val() > now && (root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid || root.child('rooms').child($code).child('members').child(auth.uid).exists())",
            ".validate": "newData.hasChildren(['online','at'])",
            "online": {
              ".validate": "newData.isBoolean()"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "commands": {
          ".read": "auth != null && root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('meta/expiresAt').val() > now && root.child('rooms').child($code).child('meta/phase').val() === 'playing' && root.child('rooms').child($code).child('members').child($uid).exists() && root.child('rooms').child($code).child('state/actorUid').val() === auth.uid && newData.child('revision').val() === root.child('rooms').child($code).child('state/revision').val()",
            ".validate": "newData.hasChildren(['id','action','revision','sentAt'])",
            "id": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "action": {
              ".validate": "newData.isString() && newData.val().matches(/^c[0-9]+$/) && newData.val().length <= 24"
            },
            "revision": {
              ".validate": "newData.isNumber()"
            },
            "value": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "sentAt": {
              ".validate": "newData.isNumber() && newData.val() >= now - 60000 && newData.val() <= now + 60000"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
